# Container dedicado da API do dashboard (separado do bot).
# Sobe o FastAPI com uvicorn na porta interna 8000; o nginx faz HTTPS + proxy.
FROM python:3.12-slim

WORKDIR /app

# Dependências: as do agente + as extras da API (fastapi/uvicorn).
COPY requirements.txt requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-api.txt

COPY . .

EXPOSE 8000

# Porta configurável por env (default 8000).
CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${API_PORT:-8000}"]
